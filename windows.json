  "dns": {
    "servers": [
      {
        "tag": "google",
        "type": "tls",
        "server": "8.8.8.8",
        "detour": "选择代理"
      },
      {
        "tag": "local-dns",
        "type": "tls",
        "server": "223.5.5.5"
      },
      {
        "tag": "fakeip-dns",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15"
      }
    ],

    "rules": [
      {
        "rule_set": [
          "geosite-youtube",
          "geosite-telegram",
          "geosite-category-media",
          "geosite-openai",
          "geosite-speedtest",
          "geosite-github",
          "geosite-jetbrains",
          "geosite-spotify",
          "geosite-cloudflare",
          "geosite-google"
        ],
        "rewrite_ttl": 1,
        "server": "fakeip-dns"
      },
      {
        "domain_suffix": [
          "edu.cn",
          "gov.cn",
          "mil.cn",
          "ac.cn",
          "com.cn",
          "net.cn",
          "org.cn",
          "中国",
          "中國"
        ],
        "server": "local-dns"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-icloud@cn",
          "geosite-apple@cn"
        ],
        "server": "local-dns"
      },
      {
        "query_type": [
          "A"
        ],
        "rewrite_ttl": 1,
        "server": "fakeip-dns"
      }
    ],

    "strategy": "ipv4_only"
  },

  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
